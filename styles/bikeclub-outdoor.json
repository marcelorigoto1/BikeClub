      "filter": ["any",
        ["match", ["get", "class"], ["bicycle", "cafe", "drinking_water", "beer", "shelter", "toilets"], true, false],
        ["==", ["get", "subclass"], "viewpoint"]
      ],
      "layout": {
        "icon-image": ["case",
          ["==", ["get", "subclass"], "viewpoint"], "viewpoint",
          ["get", "class"]],
        "icon-size": 1,
        "text-field": ["step", ["zoom"], "", 16, ["coalesce", ["get", "name"], ""]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 1.1],
        "text-max-width": 8,
        "text-optional": true,
        "symbol-sort-key": ["case", ["==", ["get", "class"], "bicycle"], 0, ["==", ["get", "class"], "drinking_water"], 1, 2]
      },
      "paint": {
        "text-color": "#4a463d",
        "text-halo-color": "#fbf8f2",
        "text-halo-width": 1.5
      }
