      "filter": ["all", ["==", ["get", "class"], "peak"], ["has", "name"], ["<=", ["coalesce", ["get", "rank"], 99], ["step", ["zoom"], 1, 12, 5, 14, 25]]],
      "layout": {
        "icon-image": "peak",
        "icon-size": 0.9,
        "text-field": ["case",
          ["has", "ele"],
          ["format",
            ["get", "name"], {},
            "\n", {},
            ["concat", ["to-string", ["get", "ele"]], " m"], { "font-scale": 0.85, "text-font": ["literal", ["Noto Sans Regular"]] }
          ],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Bold"],
        "text-size": 11,
        "text-anchor": "top",
